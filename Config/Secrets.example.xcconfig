// Copy this file to Config/Secrets.xcconfig (gitignored) and fill in real values.
// Only the host is stored, not the full URL — xcconfig treats "//" as a comment
// marker, so a full "https://..." value would be truncated at build time.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
